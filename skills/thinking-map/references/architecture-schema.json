{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thinking Map Architecture Schema",
  "type": "object",
  "required": [
    "project",
    "diagram",
    "nodes",
    "edges",
    "analysis",
    "next_actions"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "title",
        "definition",
        "goal"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": [
        "type",
        "orientation"
      ],
      "properties": {
        "type": {
          "enum": [
            "system_architecture",
            "workflow",
            "mind_map",
            "decision_tree",
            "business_architecture",
            "customer_journey",
            "knowledge_architecture",
            "roadmap",
            "ecosystem_map"
          ]
        },
        "orientation": {
          "enum": [
            "landscape"
          ]
        },
        "ratio": {
          "const": "16:9"
        },
        "logic": {
          "type": "string"
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "USER",
              "CONTEXT",
              "AI",
              "RESEARCH",
              "ASSUMPTION",
              "TBD"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "recommended",
              "assumed",
              "tbd"
            ]
          },
          "importance": {
            "enum": [
              "core",
              "support",
              "optional"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "flow",
              "depends_on",
              "feeds",
              "controls",
              "feedback",
              "choice",
              "contains"
            ]
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "supplements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tbd": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optimizations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expansion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  }
}